# ==============================================================================
# INTEGRATED INVENTORY MANAGEMENT SYSTEM (IMS) CONFIGURATION
# ==============================================================================

# Server Network Port
PORT=3000

# PostgreSQL Primary Database Connection
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=integrated_management_db

# Security & Sessions
JWT_SECRET=super_secret_enterprise_ims_key_2026_xyz
SESSION_TIMEOUT_MINUTES=120

# Integration Policies
FEFO_STRICT_ALLOCATION=true
ALLOW_NEGATIVE_STOCK=false
VALUATION_METHOD=WEIGHTED_AVERAGE_COST
AUTO_DEACTIVATE_EMS_SYNC=true
EXPIRATION_ALERT_DAYS=30,15,7,3
